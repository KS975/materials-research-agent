# =========================
# Application
# =========================
APP_NAME=materials-research-agent
APP_ENV=development
LOG_LEVEL=INFO

# =========================
# Materials business MySQL
# V0.1.1: READ ONLY
# =========================
BUSINESS_DB_HOST=39.101.193.63
BUSINESS_DB_PORT=3306
BUSINESS_DB_USER=root
BUSINESS_DB_PASSWORD=
BUSINESS_DB_NAME=materials
BUSINESS_DB_CHARSET=utf8mb4
BUSINESS_DB_CONNECT_TIMEOUT=10
BUSINESS_DB_READ_TIMEOUT=30

# =========================
# Permission Adapter
# development_header is ONLY for local integration before
# the real MatCloud/材料智元 login context adapter is confirmed.
# =========================
PERMISSION_MODE=development_header

# For local smoke scripts only.
DEV_USER_ID=
DEV_COMPANY_ID=
DEV_PROJECT_IDS=120

# =========================
# LLM Provider
# Generic OpenAI-compatible chat/completions endpoint.
# No concrete model/provider is hardcoded.
# =========================
LLM_ENABLED=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60

# =========================
# Agent Runtime DB
# Must be a SEPARATE schema/database from materials.
# Do NOT set RUNTIME_DB_NAME=materials.
# Keep false until the team approves/creates the runtime schema.
# =========================
RUNTIME_ENABLED=false
RUNTIME_DB_HOST=
RUNTIME_DB_PORT=3306
RUNTIME_DB_USER=
RUNTIME_DB_PASSWORD=
RUNTIME_DB_NAME=materials_agent_runtime
RUNTIME_DB_CHARSET=utf8mb4

CHAT_UPLOAD_DIR=.runtime/chat_uploads
CHAT_UPLOAD_MAX_MB=25
CHAT_UPLOAD_TTL_MINUTES=180

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024